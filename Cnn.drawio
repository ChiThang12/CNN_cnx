pan style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│&lt;/div&gt;&lt;div&gt;│ 0x05&amp;nbsp; &amp;nbsp;| IN_WIDTH&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;| 16&amp;nbsp; &amp;nbsp;| 15:0 | Input width&amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│&lt;/div&gt;&lt;div&gt;│ 0x06&amp;nbsp; &amp;nbsp;| IN_HEIGHT&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;| 16&amp;nbsp; &amp;nbsp;| 15:0 | Input height&amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│&lt;/div&gt;&lt;div&gt;│ 0x07&amp;nbsp; &amp;nbsp;| ACTIVATION_MODE&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;| 2&amp;nbsp; &amp;nbsp; &amp;nbsp;| 1:0&amp;nbsp; &amp;nbsp;| Activation fn &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│&lt;/div&gt;&lt;div&gt;│ 0x08&amp;nbsp; &amp;nbsp;| QUANT_MODE&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;| 2&amp;nbsp; &amp;nbsp; &amp;nbsp;| 1:0&amp;nbsp; &amp;nbsp;| Quantization&amp;nbsp; &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│&lt;/div&gt;&lt;div style=&quot;&quot;&gt;│ 0x09&amp;nbsp; &amp;nbsp;| LAYER_CTRL&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;| 8&amp;nbsp; &amp;nbsp; &amp;nbsp;| 7:0&amp;nbsp; &amp;nbsp;| Ctrl bits&amp;nbsp; &amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;│&lt;/div&gt;" vertex="1">
